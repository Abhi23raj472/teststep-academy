# Copy this file to .env and fill in your keys. Never commit .env.

# Google Cloud Console > APIs & Services > Credentials (YouTube Data API v3 enabled)
YOUTUBE_API_KEY=

# https://console.anthropic.com/ > API keys
ANTHROPIC_API_KEY=

# Optional: use a different Claude model (default is claude-opus-5-5)
# ANTHROPIC_MODEL=claude-haiku-5-5
